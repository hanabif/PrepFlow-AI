// Environment variables configuration
// Copy this file to .env.local and fill in actual values from your services

// ============================================
// SUPABASE (Authentication & Database)
// ============================================
// From: https://app.supabase.com/projects/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

// NOTE: Service role key should NEVER be exposed to client
// Only use in server-side code (server actions, API routes)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

// ============================================
// OPENAI (AI Interview Generation & Evaluation)
// ============================================
// From: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

// ============================================
// APPLICATION CONFIG
// ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
